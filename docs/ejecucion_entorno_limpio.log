        value_name="Correlacion"
    )
)

figuras_fase1["factores_demanda"] = px.bar(
    df_correlacion_visual,
    x="Variable",
    y="Correlacion",
    color="Metodo",
    barmode="group",
    text_auto=".3f",
    title="Correlación de factores meteorológicos"
)

